  author = {family=Aalst, given=W. M. P., prefix=van der, useprefix=true and Pesic, M. and Schonenberg, H.},
  date = {2009-05-01},
  journaltitle = {Computer Science - Research and Development},
  shortjournal = {Comput. Sci. - Res. Dev.},
